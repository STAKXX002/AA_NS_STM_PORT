mach create "stm32f446"
machine LoadPlatformDescription @platforms/cpus/stm32f4.repl

# Suppress non-critical USART peripheral warnings
logLevel 3 sysbus.usart2

# Increased quantum step size from 0.0001 to 0.001 to prevent host wall-clock timeout during motor stepping
emulation SetGlobalQuantum "0.001"

# Point directly to the Release build ELF
sysbus LoadELF @build/Release/AA_NS_STM_V1.elf

# Set active-low limit switches (PB8, PB10) HIGH on boot (unpressed state)
sysbus.gpioPortB OnGPIO 8 true
sysbus.gpioPortB OnGPIO 10 true

# Set Relay Outputs (PB7 Light, PB9 Fan) HIGH on boot (Inactive state for active-LOW relays)
sysbus.gpioPortB OnGPIO 7 true
sysbus.gpioPortB OnGPIO 9 true

# Setup socket server for UART2 communication with the Python script
emulation CreateServerSocketTerminal 1234 "uart_terminal"
connector Connect sysbus.usart2 uart_terminal

start